# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# --- Target environment ---
# Base URL the suite runs against (no trailing slash). Root domain, not the
# /dashboard path — DashboardPage.path already appends "/dashboard".
BASE_URL=https://app.fridai.pro

# Environment label used in reports (dev / staging / uat / prod).
ENV=staging

# --- UI auth ---
# Test user credentials. Use a dedicated automation account, never a real user.
FRIDAI_TEST_USER=automation@fridai.local
FRIDAI_TEST_PASSWORD=change-me

# --- Playwright runtime ---
# Set to 1 to slow each action by N ms when debugging locally.
PWDEBUG=0

# Default timeout for page actions (ms). Tests may override per-call.
PLAYWRIGHT_DEFAULT_TIMEOUT=30000
